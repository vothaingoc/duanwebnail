---
import SiteLayout from '../components/SiteLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getBlogPostsWithFallback } from '../lib/sanity';
import { pageSeo } from '../data/site';

const posts = (await getBlogPostsWithFallback())
  .filter((post: any) => post.slug || post.id)
  .sort((a: any, b: any) => String(b.date || '').localeCompare(String(a.date || '')));
const postImage = (post: any) => {
  const value = post.image || post.featuredImage || '';
  return value && !value.startsWith('http') && !value.startsWith('/') ? `/${value}` : value;
};
---

<SiteLayout title={pageSeo.news.title} description={pageSeo.news.description} path="/news/">
  <main>
    <Breadcrumbs items={[{ label: 'ネイルコラム' }]} />
    <section class="page-hero"><p class="eyebrow">Golyn Nail Journal</p><h1>ネイルコラム</h1><p class="lead">ネイルデザイン、ケア、トレンド、初めてのサロン利用に役立つ情報をご紹介します。</p><div class="gold-line"></div></section>
    <section class="section" aria-labelledby="article-list-title">
      <div class="section-inner">
        <div class="section-heading"><p class="eyebrow">Latest Articles</p><h2 id="article-list-title">公開中の記事</h2></div>
        {posts.length ? (
          <div class="post-grid">
            {posts.map((post: any) => (
              <article>
                {postImage(post) ? <a class="post-image" href={`/article/${post.slug || post.id}/`} tabindex="-1"><img src={postImage(post)} alt={post.title ? `${post.title}の記事画像` : 'Golyn Nailネイルコラム'} width="720" height="460" loading="lazy" decoding="async" /></a> : <div class="post-placeholder" aria-hidden="true">Golyn Nail Journal</div>}
                <div class="post-body">
                  <p class="meta"><span>{post.tag || post.lang || 'Column'}</span>{post.date && <time datetime={post.date}>{post.date}</time>}</p>
                  <h2><a href={`/article/${post.slug || post.id}/`}>{post.title || 'ネイルコラム'}</a></h2>
                  <p>{post.excerpt || post.desc || '記事の内容をご覧ください。'}</p>
                  <a class="text-link" href={`/article/${post.slug || post.id}/`}>記事を読む →</a>
                </div>
              </article>
            ))}
          </div>
        ) : <p class="notice">記事は現在準備中です。</p>}
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  article { overflow: hidden; background: var(--white); border: 1px solid var(--cream-deep); }
  .post-image, .post-placeholder { display: grid; place-items: center; aspect-ratio: 16/9; overflow: hidden; background: linear-gradient(135deg, var(--cream-mid), var(--cream)); color: var(--gold); font-family: var(--serif); font-size: 28px; letter-spacing: .08em; }
  .post-image img { width: 100%; height: 100%; object-fit: cover; }
  .post-body { padding: 26px; }
  .meta { display: flex; justify-content: space-between; gap: 12px; margin: 0; color: var(--text-light); font-size: 12px; }
  .meta span { color: var(--gold); font-weight: 500; }
  h2 { margin: 12px 0 10px; font-family: var(--serif); font-size: 29px; font-weight: 500; line-height: 1.25; }
  h2 a { color: var(--brown-deep); text-decoration: none; }
  .post-body > p:not(.meta) { color: var(--text-mid); }
  @media (max-width: 760px) { .post-grid { grid-template-columns: 1fr; } }
</style>
