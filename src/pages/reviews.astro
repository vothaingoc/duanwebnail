---
import SiteLayout from '../components/SiteLayout.astro';

const title = '口コミ | Golyn Nail 大阪のネイルサロン';
const description = 'Golyn Nailをご利用いただいたお客様の声。大阪で丁寧なカウンセリング、上品な空間、長持ちするジェルネイルをご提供します。';
---

<SiteLayout title={title} description={description}>
  <main>
    <section class="testimonials testimonials-page" id="testimonials" aria-labelledby="reviews-title">
      <div class="sec-header">
        <div class="sec-eyebrow">Customer Reviews</div>
        <h1 class="sec-title" id="reviews-title">お客様の<em>声</em></h1>
        <div class="sec-line"></div>
      </div>
      <div class="test-grid">
        <article class="test-card">
          <div class="test-stars">★★★★★</div>
          <p class="test-quote">「大阪で一番気に入っているネイルサロンです。担当の方がとても丁寧で親切でした。」</p>
          <div class="test-author">— Kimura Yuki, Osaka</div>
        </article>
        <article class="test-card">
          <div class="test-stars">★★★★★</div>
          <p class="test-quote">「空間がとても上品でリラックスできます。ジェルネイルが5週間経っても剥がれませんでした。」</p>
          <div class="test-author">— Tanaka Haruka, Namba</div>
        </article>
        <article class="test-card">
          <div class="test-stars">★★★★★</div>
          <p class="test-quote">「ネイルアートのデザインが期待以上でした。毎月通いたいですし、友人にも勧めたいです。」</p>
          <div class="test-author">— Nguyen Linh, 留学生</div>
        </article>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .testimonials {
    padding: calc(var(--nav-h) + 76px) 80px 96px;
    background: var(--cream-mid);
  }
  .sec-header {
    text-align: center;
    margin-bottom: 58px;
  }
  .sec-eyebrow {
    font-size: 12px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .sec-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 300;
    color: var(--brown-deep);
    line-height: 1.18;
  }
  .sec-title em {
    font-style: italic;
    color: var(--beige-dark);
  }
  .test-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .test-card {
    background: var(--white);
    padding: 34px 30px;
    border-radius: 4px;
    border-bottom: 2px solid var(--cream-deep);
    transition: border-color .25s, transform .25s;
  }
  .test-card:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
  }
  .test-stars {
    color: var(--gold);
    letter-spacing: 2px;
    font-size: 12px;
    margin-bottom: 16px;
  }
  .test-quote {
    font-family: var(--serif);
    font-size: 18px;
    font-style: italic;
    color: var(--brown-deep);
    line-height: 1.65;
    margin-bottom: 22px;
  }
  .test-author {
    font-size: 13px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-light);
  }
  @media (max-width: 900px) {
    .testimonials {
      padding: calc(var(--nav-h) + 50px) 20px 64px;
    }
    .test-grid {
      grid-template-columns: 1fr;
      max-width: 680px;
    }
  }
</style>
