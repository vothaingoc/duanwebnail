---
import SiteLayout from '../components/SiteLayout.astro';

const title = 'Customer Reviews | Golyn Nail Osaka';
const description = 'Read customer review highlights for Golyn Nail, a nail salon in Osaka offering gel nails, nail art, foot nails, and careful salon service.';
---

<SiteLayout title={title} description={description}>
  <main>
    <section class="page-hero">
      <div class="hero-eyebrow">Customer Reviews</div>
      <h1>Golyn Nail Reviews</h1>
      <p>Customer voices about design consultation, careful nail work, relaxing salon time, and long lasting gel nails.</p>
      <div class="sec-line"></div>
    </section>

    <section class="seo-page-section" aria-labelledby="reviews-title">
      <div class="section-heading">
        <p>Voice</p>
        <h2 id="reviews-title">What customers appreciate about Golyn Nail</h2>
      </div>
      <div class="review-grid">
        <article>
          <div class="stars">★★★★★</div>
          <p>Careful consultation and beautiful nail art. The finish felt elegant and easy to wear every day.</p>
          <span>Osaka customer</span>
        </article>
        <article>
          <div class="stars">★★★★★</div>
          <p>The salon atmosphere is calm, and the gel nails lasted well while keeping a clean shape.</p>
          <span>Namba customer</span>
        </article>
        <article>
          <div class="stars">★★★★★</div>
          <p>The design result was even better than expected. I would recommend it for detailed nail art.</p>
          <span>International customer</span>
        </article>
      </div>
      <div class="page-actions">
        <a class="btn-primary" href="/access/">Contact Golyn Nail</a>
        <a class="btn-secondary" href="/gallery/">View Designs</a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .seo-page-section {
    padding: 72px 20px 96px;
  }
  .section-heading {
    max-width: 840px;
    margin: 0 auto 34px;
    text-align: center;
  }
  .section-heading p {
    margin-bottom: 8px;
    color: var(--gold);
    font-size: 12px;
    letter-spacing: .26em;
    text-transform: uppercase;
  }
  .section-heading h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    color: var(--brown-deep);
    line-height: 1.2;
  }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .review-grid article {
    min-height: 240px;
    padding: 30px 26px;
    background: var(--white);
    border: 1px solid rgba(217,197,160,.72);
    border-bottom: 2px solid var(--cream-deep);
    border-radius: 6px;
    box-shadow: 0 12px 36px rgba(74,55,40,.07);
  }
  .stars {
    margin-bottom: 18px;
    color: var(--gold);
    letter-spacing: .08em;
  }
  .review-grid p {
    margin-bottom: 18px;
    color: var(--brown-deep);
    font-family: var(--serif);
    font-size: 20px;
    font-style: italic;
    line-height: 1.7;
  }
  .review-grid span {
    color: var(--text-light);
    font-size: 13px;
  }
  .page-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
    flex-wrap: wrap;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 28px;
    border-radius: 2px;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: .12em;
  }
  .btn-primary {
    background: var(--brown-deep);
    color: var(--cream);
  }
  .btn-secondary {
    border: 1px solid var(--cream-deep);
    color: var(--brown-deep);
  }
  @media (max-width: 900px) {
    .review-grid { grid-template-columns: 1fr; max-width: 680px; }
  }
  @media (max-width: 640px) {
    .seo-page-section { padding: 56px 20px 72px; }
  }
</style>
