---
import SiteLayout from '../components/SiteLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { pageSeo } from '../data/site';
---

<SiteLayout title={pageSeo.services.title} description={pageSeo.services.description} path="/services/">
  <main>
    <Breadcrumbs items={[{ label: 'ネイルサービス' }]} />
    <section class="page-hero"><p class="eyebrow">Nail Services</p><h1>ネイルサービス</h1><p class="lead">お好みや爪の状態を確認しながら、デザインと施術内容をご相談いただけます。</p><div class="gold-line"></div></section>
    <section class="section" aria-labelledby="service-list-title">
      <div class="section-inner">
        <div class="section-heading"><p class="eyebrow">Our Menu</p><h2 id="service-list-title">対応サービス</h2></div>
        <div class="service-list">
          <article><span>01</span><div><h3>ジェルネイル</h3><p>ワンカラー、フラッシュネイル、ラメグラデーションなど、日常になじむデザインから華やかな仕上がりまで対応します。</p></div></article>
          <article><span>02</span><div><h3>ネイルアート・持ち込みデザイン</h3><p>4本・6本・10本アートなど、ご希望のボリュームに合わせたコースをご用意しています。参考画像をお持ちいただく場合は、使用するパーツや施術可否を事前に確認します。</p></div></article>
          <article><span>03</span><div><h3>韓国ネイル・ワンホンネイル</h3><p>透明感のあるカラー、きらめき、ストーンやパーツを取り入れたトレンドデザインをご相談いただけます。</p></div></article>
          <article><span>04</span><div><h3>長さ出し</h3><p>自然な長さからロングネイルまで、ご希望のフォルムやデザインに合わせて施術内容をご案内します。</p></div></article>
          <article><span>05</span><div><h3>フットネイル・オフ・ケア</h3><p>フットネイル、付け替えオフ、オフのみ、パーツやケアなどのオプションを料金ページでご確認いただけます。</p></div></article>
        </div>
        <p class="actions"><a class="button-link" href="/price/">メニュー・料金を見る</a><a class="text-link" href="/gallery/">デザインを見る →</a></p>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .service-list { max-width: 940px; margin: 0 auto; border-top: 1px solid var(--cream-deep); }
  article { display: grid; grid-template-columns: 80px 1fr; gap: 24px; padding: 34px 0; border-bottom: 1px solid var(--cream-deep); }
  article > span { color: var(--gold); font-family: var(--serif); font-size: 34px; }
  h3 { margin: 0 0 8px; color: var(--brown-deep); font-family: var(--serif); font-size: 30px; font-weight: 500; }
  p { color: var(--text-mid); }
  .actions { display: flex; justify-content: center; align-items: center; gap: 28px; margin-top: 44px; }
  @media (max-width: 600px) { article { grid-template-columns: 46px 1fr; gap: 14px; } .actions { flex-direction: column; } }
</style>
