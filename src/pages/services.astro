---
import SiteLayout from '../components/SiteLayout.astro';

const title = 'サービス | 大阪・心斎橋ネイル Golyn Nail';
const description = '大阪・心斎橋エリアのGolyn Nailサービス。ジェルネイル、アートデザイン、長さ出し、フットネイルまで丁寧に施術。Shinsaibashi nail store services.';
---

<SiteLayout title={title} description={description}>
  <main>
    <section class="services services-page" id="services" aria-labelledby="services-title">
      <div class="sec-header">
        <div class="sec-eyebrow">Our Services</div>
        <h1 class="sec-title" id="services-title">私たちの<em>サービス</em></h1>
        <div class="sec-line"></div>
      </div>
      <div class="services-grid">
        <article class="service-card">
          <div class="service-num">01</div>
          <div class="service-name">Gel Nail</div>
          <p class="service-desc">ワンカラー・フラッシュ・ラメグラ。韓国・ワンホン・ニュアンスにも対応。</p>
          <div class="service-price" data-service-price="gel-onecolor">¥5,900〜※ 期間限定キャンペーン価格</div>
        </article>
        <article class="service-card">
          <div class="service-num">02</div>
          <div class="service-name">Art Design</div>
          <p class="service-desc">4本・6本・10本アート。人気パーツ込み、持ち込みデザインOK。</p>
          <div class="service-price" data-service-price="gel-4art">¥8,200〜※ 期間限定キャンペーン価格</div>
        </article>
        <article class="service-card">
          <div class="service-num">03</div>
          <div class="service-name">Long Nail / 長さ出し</div>
          <p class="service-desc">長さ出し・スカルプ・ジェルチップ対応。超ロングや韓国ネイルも人気。</p>
          <div class="service-price" data-service-price="ext-onecolor">¥6,800〜※ 期間限定キャンペーン価格</div>
        </article>
        <article class="service-card">
          <div class="service-num">04</div>
          <div class="service-name">Foot Nail</div>
          <p class="service-desc">フットワンカラーから10本アートまで。夏人気のフットネイルにも対応。</p>
          <div class="service-price" data-service-price="foot-onecolor">¥4,600〜※ 期間限定キャンペーン価格</div>
        </article>
      </div>
    </section>
  </main>
  <script is:inline src="/assets/js/pricing-data.js"></script>
  <script is:inline src="/assets/js/pricing-render.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const lang = localStorage.getItem('golynLang') || 'ja';
      if (window.GolynPricing) {
        window.GolynPricing.renderServicePrices(lang);
        window.GolynPricing.applyCampaignState();
      }
    });
  </script>
</SiteLayout>

<style>
  .services {
    padding: calc(var(--nav-h) + 76px) 80px 96px;
    background: var(--white);
  }
  .sec-header {
    text-align: center;
    margin-bottom: 58px;
  }
  .sec-eyebrow {
    font-size: 12px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  .sec-title {
    font-family: var(--serif);
    font-size: clamp(32px, 3.6vw, 50px);
    font-weight: 300;
    color: var(--brown-deep);
    line-height: 1.18;
  }
  .sec-title em {
    font-style: italic;
    color: var(--beige-dark);
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    max-width: 900px;
    margin: 0 auto;
  }
  .service-card {
    background: var(--cream);
    padding: 42px 32px;
    position: relative;
    overflow: hidden;
    transition: .3s;
  }
  .service-card:hover {
    background: var(--cream-mid);
  }
  .service-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width .4s;
    box-shadow: 0 0 10px rgba(201,150,60,.4);
  }
  .service-card:hover::after {
    width: 100%;
  }
  .service-num {
    font-family: var(--serif);
    font-size: 44px;
    font-weight: 300;
    color: var(--cream-deep);
    line-height: 1;
    margin-bottom: 20px;
  }
  .service-name {
    font-size: 13px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--brown-deep);
    font-weight: 500;
    margin-bottom: 10px;
  }
  .service-desc {
    font-size: 15px;
    color: var(--text-mid);
    line-height: 1.85;
    margin-bottom: 16px;
  }
  .service-price {
    color: var(--brown);
  }
  :global(.service-price-value) {
    display: block;
    font-family: var(--serif);
    font-size: 22px;
    font-style: italic;
    line-height: 1.25;
  }
  .service-price :global(.service-campaign) {
    display: block;
    font-family: var(--sans);
    font-size: 11px;
    line-height: 1.5;
    font-style: normal;
    color: var(--text-light);
    letter-spacing: .04em;
    margin-top: 4px;
  }
  @media (max-width: 768px) {
    .services {
      padding: calc(var(--nav-h) + 50px) 20px 64px;
    }
    .services-grid {
      grid-template-columns: 1fr;
    }
    .service-card {
      padding: 34px 26px;
    }
  }
</style>
