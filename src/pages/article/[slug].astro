---
import SiteLayout from '../../components/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { business } from '../../config/business';
import { getBlogPostsWithFallback } from '../../lib/sanity';

export async function getStaticPaths() {
  const posts = await getBlogPostsWithFallback();
  const seen = new Set<string>();
  return posts.flatMap((post: any) => {
    const slug = String(post.slug || post.id || '').trim();
    if (!slug || seen.has(slug)) return [];
    seen.add(slug);
    return [{ params: { slug }, props: { post } }];
  });
}

const { post } = Astro.props;
const slug = String(post.slug || post.id);
const title = post.seoTitle || `${post.title || 'ネイルコラム'}｜Golyn Nail`;
const description = post.seoDescription || post.excerpt || post.desc || 'Golyn Nailのネイルコラムです。';
const rawImage = post.image || post.featuredImage || '';
const image = rawImage && !rawImage.startsWith('http') && !rawImage.startsWith('/') ? `/${rawImage}` : rawImage;
const rawBody = String(post.body || post.content || '');
const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char));
const markdownToHtml = (value: string) => value
  .replace(/<img\b[^>]*>/gi, '')
  .split(/\r?\n/)
  .map((line) => {
    const safe = escapeHtml(line.trim());
    if (!safe) return '';
    if (safe.startsWith('### ')) return `<h3>${safe.slice(4)}</h3>`;
    if (safe.startsWith('## ')) return `<h2>${safe.slice(3)}</h2>`;
    if (safe.startsWith('* ')) return `<p class="bullet">• ${safe.slice(2)}</p>`;
    return `<p>${safe}</p>`;
  }).join('');
const bodyHtml = post.html || markdownToHtml(rawBody);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title || title,
  description,
  datePublished: post.date || undefined,
  image: image ? new URL(image, business.siteUrl).toString() : undefined,
  mainEntityOfPage: new URL(`/article/${slug}/`, business.siteUrl).toString(),
  publisher: { '@id': `${business.siteUrl}/#organization` },
};
---

<SiteLayout title={title} description={description} path={`/article/${slug}/`} image={image || undefined} type="article" lang={post.lang || 'ja'} jsonLd={articleSchema}>
  <main>
    <Breadcrumbs items={[{ label: 'ネイルコラム', href: '/news/' }, { label: post.title || '記事' }]} />
    <article class="article-page">
      <header>
        <p class="eyebrow">{post.tag || 'Golyn Nail Journal'}</p>
        <h1>{post.title || 'ネイルコラム'}</h1>
        {post.date && <time datetime={post.date}>{post.date}</time>}
        {image && <img src={image} alt={`${post.title || 'ネイルコラム'}の記事画像`} width="1000" height="640" fetchpriority="high" />}
      </header>
      <div class="article-body" set:html={bodyHtml} />
      <p class="back"><a class="button-link" href="/news/">ネイルコラム一覧へ戻る</a></p>
    </article>
  </main>
</SiteLayout>

<style>
  .article-page { max-width: 900px; margin: 0 auto; padding: clamp(54px, 8vw, 90px) 24px; }
  header { text-align: center; }
  h1 { margin: 0; color: var(--brown-deep); font-family: var(--serif); font-size: clamp(38px, 6vw, 62px); font-weight: 500; line-height: 1.2; }
  time { display: block; margin-top: 14px; color: var(--text-light); font-size: 13px; }
  header img { width: 100%; max-height: 620px; margin-top: 34px; object-fit: cover; }
  .article-body { margin-top: 42px; color: var(--text-mid); font-size: 16px; line-height: 1.95; }
  .article-body :global(h2) { margin: 46px 0 14px; color: var(--brown-deep); font-family: var(--serif); font-size: 34px; font-weight: 500; }
  .article-body :global(h3) { margin: 34px 0 12px; color: var(--brown-deep); font-size: 22px; font-weight: 500; }
  .article-body :global(p) { margin: 0 0 20px; }
  .article-body :global(.bullet) { margin-bottom: 8px; padding-left: 10px; }
  .article-body :global(img) { max-width: 100%; height: auto; }
  .back { margin-top: 52px; text-align: center; }
</style>
