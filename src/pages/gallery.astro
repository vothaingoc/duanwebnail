---
import SiteLayout from '../components/SiteLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getGalleryWithFallback } from '../lib/sanity';
import { pageSeo } from '../data/site';

const items = await getGalleryWithFallback();
const imageSrc = (item: any) => {
  const value = item.image || item.src || '';
  return value.startsWith('http') || value.startsWith('/') ? value : `/${value}`;
};
---

<SiteLayout title={pageSeo.gallery.title} description={pageSeo.gallery.description} path="/gallery/" image={imageSrc(items[0] || {}) || undefined}>
  <main>
    <Breadcrumbs items={[{ label: 'ネイルデザイン・ギャラリー' }]} />
    <section class="page-hero">
      <p class="eyebrow">Nail Design Gallery</p>
      <h1>ネイルデザイン・ギャラリー</h1>
      <p class="lead">Golyn Nailのギャラリーに公開されているネイルデザインをご覧いただけます。</p>
      <div class="gold-line"></div>
    </section>
    <section class="section" aria-labelledby="design-list-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Portfolio</p>
          <h2 id="design-list-title">公開中のデザイン</h2>
        </div>
        {items.length ? (
          <div class="gallery-grid">
            {items.map((item: any, index) => (
              <figure>
                <img src={imageSrc(item)} alt={item.alt || item.title || item.label || 'Golyn Nailのネイルデザイン'} width="720" height="900" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
                <figcaption><strong>{item.title || item.label || 'Nail Design'}</strong>{item.tag && <span>{item.tag}</span>}</figcaption>
              </figure>
            ))}
          </div>
        ) : <p class="notice">ネイルデザインは現在準備中です。公開まで今しばらくお待ちください。</p>}
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  figure { margin: 0; background: var(--white); border: 1px solid var(--cream-deep); overflow: hidden; }
  figure img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  figcaption { display: flex; justify-content: space-between; gap: 14px; padding: 16px 18px; color: var(--text-mid); }
  figcaption strong { color: var(--brown-deep); font-family: var(--serif); font-size: 20px; font-weight: 500; }
  figcaption span { color: var(--gold); font-size: 12px; }
  @media (max-width: 760px) { .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; } figcaption { display: block; padding: 12px; } figcaption span { display: block; } }
</style>
