---
import { salonTranslations, mapUrl, mapEmbedUrl } from "../data/salon";
import SiteLayout from '../components/SiteLayout.astro';

const title = 'アクセス・予約 | 大阪・心斎橋ネイル Golyn Nail';
const description = 'Golyn Nailのアクセス・予約情報。大阪・心斎橋エリアでネイルサロンをお探しの方へ。LINE、Instagram、Google Mapsからお問い合わせください。';
---

<SiteLayout title={title} description={description}>
  <main>
    <section class="page-hero">
      <div class="hero-eyebrow">Access</div>
      <h1 data-i18n="acc_title">店舗へのアクセス</h1>
      <p data-i18n="acc_addr" set:html={salonTranslations.ja.acc_addr} />
      <div class="sec-line"></div>
    </section>

    <section class="access-page" aria-labelledby="access-title">
      <div class="section-heading">
        <p data-i18n="acc_eyebrow">アクセス</p>
        <h2 id="access-title">Golyn Nail</h2>
      </div>
      <div class="access-grid">
        <div class="map-wrap">
          <iframe allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={mapEmbedUrl} title="Golyn Nail map"></iframe>
        </div>
        <div class="access-card">
          <h3>Golyn Nail</h3>
          <dl>
            <div>
              <dt data-i18n="acc_addr_label">住所</dt>
              <dd data-i18n="acc_addr" set:html={salonTranslations.ja.acc_addr} />
            </div>
            <div>
              <dt data-i18n="acc_hours_label">営業時間</dt>
              <dd data-i18n="acc_hours" set:html={salonTranslations.ja.acc_hours} />
            </div>
            <div>
              <dt data-i18n="acc_dir_label">最寄り駅からのアクセス</dt>
              <dd><p data-i18n="acc_dir1">{salonTranslations.ja.acc_dir1}</p><p data-i18n="acc_dir2">{salonTranslations.ja.acc_dir2}</p><p data-i18n="acc_dir3">{salonTranslations.ja.acc_dir3}</p><p data-i18n="acc_dir4">{salonTranslations.ja.acc_dir4}</p></dd>
            </div>
          <div><dt data-i18n="acc_tel_label">電話</dt><dd><a href="tel:07088366688">070-8836-6688</a></dd></div></dl>
          <div class="page-actions">
            <a class="btn-primary" href={mapUrl} rel="noopener noreferrer" target="_blank" data-i18n="acc_map_link">Google マップで開く</a>
            <a class="btn-secondary" href="https://www.instagram.com/golynnail?igsh=MWhoNmR1NXV1dnFmcg%3D%3D&utm_source=qr" rel="noopener noreferrer" target="_blank">Instagram</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .access-page {
    padding: 72px 20px 96px;
  }
  .section-heading {
    max-width: 840px;
    margin: 0 auto 34px;
    text-align: center;
  }
  .section-heading p {
    margin-bottom: 8px;
    color: var(--gold);
    font-size: 12px;
    letter-spacing: .26em;
    text-transform: uppercase;
  }
  .section-heading h2 {
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    color: var(--brown-deep);
    line-height: 1.2;
  }
  .access-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, .9fr);
    gap: 32px;
    max-width: 1100px;
    margin: 0 auto;
    align-items: stretch;
  }
  .map-wrap {
    min-height: 430px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(74,55,40,.1);
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .access-card {
    padding: 34px 30px;
    background: var(--white);
    border: 1px solid rgba(217,197,160,.72);
    border-bottom: 2px solid var(--cream-deep);
    border-radius: 6px;
    box-shadow: 0 12px 36px rgba(74,55,40,.07);
  }
  .access-card h3 {
    margin-bottom: 24px;
    font-family: var(--serif);
    font-size: 34px;
    font-weight: 400;
    color: var(--brown-deep);
  }
  .access-card dl,
  .access-card dd {
    margin: 0;
  }
  .access-card dl > div {
    padding: 18px 0;
    border-top: 1px solid var(--cream-deep);
  }
  .access-card dt {
    margin-bottom: 8px;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .access-card dd {
    color: var(--text-mid);
    font-size: 14px;
    line-height: 1.8;
  }
  .page-actions {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 24px;
    border-radius: 2px;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: .12em;
  }
  .btn-primary {
    width: fit-content;
    flex: 0 0 auto;
    border-radius: 12px;
    padding: 10px 18px;
    background: var(--gold);
    color: var(--brown-deep);
    border: 1px solid var(--gold);
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(201,150,60,.18);
  }
  .btn-secondary {
    border: 1px solid var(--cream-deep);
    color: var(--brown-deep);
  }
  @media (max-width: 900px) {
    .access-grid { grid-template-columns: 1fr; max-width: 760px; }
  }
  @media (max-width: 640px) {
    .access-page { padding: 56px 20px 72px; }
    .map-wrap { min-height: 320px; }
  }
</style>
