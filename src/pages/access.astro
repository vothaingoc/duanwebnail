---
import SiteLayout from '../components/SiteLayout.astro';
import { stores } from '../data/stores';
const translations = Object.fromEntries(Object.keys(stores[0]?.translations || {}).map(lang => [lang,
  Object.fromEntries(stores.flatMap(store => [
    [`store_${store.slug}_address`, store.translations[lang].acc_addr],
    [`store_${store.slug}_station`, store.translations[lang].acc_dir1]
  ]))
]));
---
<SiteLayout title="店舗案内・店舗一覧 | Golyn Nail" description="Golyn Nailの店舗一覧。各店舗の写真、営業時間、所在地とアクセスをご案内します。" translations={translations}>
  <main>
    <section class="page-hero">
      <div class="hero-eyebrow">Our Salons</div>
      <h1 data-i18n="stores_title">店舗一覧</h1>
      <p data-i18n="stores_intro">ご希望の店舗を選び、店内の様子やアクセスをご確認ください。</p>
      <div class="sec-line"></div>
    </section>
    <section class="store-list" aria-label="Golyn Nail salons">
      <div class="store-grid">
        {stores.map(store => (
          <article class="store-card">
            <a class="store-photo" href={`/access/${store.slug}/`}>
              <img src={store.photos[0]} alt={`Golyn Nail ${store.name}`} width="2016" height="1512" />
            </a>
            <div class="store-body">
              <p class="store-brand">Golyn Nail</p>
              <h2><a href={`/access/${store.slug}/`} data-i18n={store.nameKey}>{store.name}</a></h2>
              <p class="store-address" data-i18n={`store_${store.slug}_address`} set:html={store.translations.ja.acc_addr} />
              <p class="store-station" data-i18n={`store_${store.slug}_station`}>{store.translations.ja.acc_dir1}</p>
              <a class="store-button" href={`/access/${store.slug}/`} data-i18n="store_details">店舗詳細を見る</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
</SiteLayout>
<style>
  .store-list { padding:64px 20px 96px; }
  .store-grid { display:flex; flex-wrap:wrap; justify-content:center; align-items:stretch; gap:28px; max-width:1100px; margin:0 auto; }
  .store-card { flex:0 1 calc((100% - 28px) / 2); min-width:0; max-width:536px; display:flex; flex-direction:column; overflow:hidden; background:var(--white); border:1px solid var(--cream-deep); border-radius:8px; box-shadow:0 12px 36px rgba(74,55,40,.07); }
  .store-photo { display:block; overflow:hidden; }
  .store-photo img { display:block; width:100%; height:auto; aspect-ratio:4/3; object-fit:cover; transition:transform .4s; }
  .store-photo:hover img { transform:scale(1.025); }
  .store-body { padding:28px 30px 32px; display:flex; flex-direction:column; flex:1; }
  .store-brand { color:var(--gold); font-size:14px; letter-spacing:.16em; margin-bottom:8px; }
  h2 { font-family:var(--serif); font-size:clamp(28px,4vw,36px); font-weight:300; margin-bottom:20px; }
  h2 a { color:var(--brown-deep); text-decoration:none; }
  .store-address, .store-station { color:var(--text-mid); font-size:16px; line-height:1.9; }
  .store-station { margin:14px 0 26px; }
  .store-button { align-self:flex-start; margin-top:auto; display:inline-flex; align-items:center; justify-content:center; min-height:46px; padding:12px 24px; background:var(--brown-deep); color:var(--cream); text-decoration:none; border-radius:2px; font-size:14px; letter-spacing:.08em; }
  .store-button:hover { background:var(--brown); }
  @media(max-width:640px) { .store-list { padding:40px 20px 64px; } .store-card { flex-basis:100%; } .store-body { padding:24px; } }
</style>
