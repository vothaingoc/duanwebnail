---
import SiteLayout from '../../components/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { pageSeo } from '../../data/site';
import { getPricingDataOverride } from '../../lib/sanity';
import { formatYen, getPricingFallback } from '../../lib/pricing-fallback';

const fallback = await getPricingFallback();
const sanity = await getPricingDataOverride();
const pricing = sanity || fallback;
const categories = Object.entries(pricing.categories || {});
const items = Array.isArray(pricing.items) ? pricing.items : [];
const categoryTitle = (key: string, category: any) => category.translations?.ja || category.title || category.label || key;
const itemText = (item: any) => ({ ...(item.translations?.ja || {}), name: item.translations?.ja?.name || item.name || '' });
---

<SiteLayout title={pageSeo.price.title} description={pageSeo.price.description} path="/price/">
  <main>
    <Breadcrumbs items={[{ label: 'ネイルメニュー・料金' }]} />
    <section class="page-hero"><p class="eyebrow">Menu & Price</p><h1>ネイルメニュー・料金</h1><p class="lead">公開済みの料金データをカテゴリー別にご案内します。表示価格と施術内容をご確認ください。</p><div class="gold-line"></div></section>
    <section class="section" aria-labelledby="price-list-title">
      <div class="section-inner">
        <div class="section-heading"><p class="eyebrow">Price List</p><h2 id="price-list-title">料金一覧</h2></div>
        <div class="price-groups">
          {categories.map(([key, category]: [string, any]) => {
            const categoryItems = items.filter((item: any) => item.category === key).sort((a: any, b: any) => (a.order || 0) - (b.order || 0));
            if (!categoryItems.length) return null;
            return (
              <section class:list={['price-group', { featured: category.featured }]}>
                <header><p>{category.label || 'Nail Menu'}</p><h2>{categoryTitle(key, category)}</h2></header>
                <ul>
                  {categoryItems.map((item: any) => {
                    const text = itemText(item);
                    const price = formatYen(text.originalPrice ?? item.originalPrice);
                    return (
                      <li>
                        <div><h3>{text.name}</h3>{(text.duration || text.description) && <p>{[text.duration, text.description].filter(Boolean).join(' / ')}</p>}{text.note && <small>{text.note}</small>}</div>
                        {price && <strong>{price}</strong>}
                      </li>
                    );
                  })}
                </ul>
              </section>
            );
          })}
        </div>
        <div class="notice"><strong>料金について</strong><p>キャンペーン価格は、管理画面で有効期間が設定されている場合にのみ表示対象となります。追加オプションやデザイン内容により料金が変わる場合は、予約受付開始後に事前確認をご案内します。</p></div>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .price-groups { display: grid; gap: 30px; max-width: 1040px; margin: 0 auto 42px; }
  .price-group { overflow: hidden; background: var(--white); border: 1px solid var(--cream-deep); }
  .price-group > header { padding: 26px 30px 20px; background: linear-gradient(110deg, var(--cream-mid), var(--white)); border-bottom: 1px solid var(--cream-deep); }
  .price-group > header p { margin: 0; color: var(--gold); font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  .price-group h2 { margin: 3px 0 0; color: var(--brown-deep); font-family: var(--serif); font-size: 34px; font-weight: 500; }
  .price-group ul { margin: 0; padding: 0; list-style: none; }
  .price-group li { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center; padding: 22px 30px; border-bottom: 1px solid rgba(212,189,153,.55); }
  .price-group li:last-child { border-bottom: 0; }
  h3 { margin: 0; color: var(--brown-deep); font-size: 16px; font-weight: 500; }
  li p, li small { display: block; margin: 5px 0 0; color: var(--text-light); font-size: 13px; }
  li strong { color: var(--brown); font-family: var(--serif); font-size: 22px; white-space: nowrap; }
  .notice strong { color: var(--brown-deep); }
  .notice p { margin-bottom: 0; }
  @media (max-width: 600px) { .price-group li { grid-template-columns: 1fr; gap: 8px; padding: 20px; } .price-group > header { padding: 22px 20px; } }
</style>
