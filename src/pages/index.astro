---
import SiteLayout from '../components/SiteLayout.astro';
import { getGalleryWithFallback } from '../lib/sanity';
import { pageSeo, primaryNavigation } from '../data/site';

const gallery = (await getGalleryWithFallback()).slice(0, 6);
const imageSrc = (item: any) => {
  const value = item.image || item.src || '';
  if (!value) return '';
  return value.startsWith('http') || value.startsWith('/') ? value : `/${value}`;
};
---

<SiteLayout title={pageSeo.home.title} description={pageSeo.home.description} path="/">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <p class="eyebrow">Osaka Nail Salon</p>
        <h1>大阪のネイルサロン<br /><span>Golyn Nail（ゴーリンネイル）</span></h1>
        <p class="hero-lead">
          Golyn Nailは、大阪でオープン準備を進めているネイルサロンブランドです。ジェルネイル、ネイルアート、韓国ネイル、ワンホンネイル、長さ出し、持ち込みデザインなど、幅広いメニューをご案内します。
        </p>
        <div class="hero-actions">
          <a class="button-link" href="/gallery/">ネイルデザインを見る</a>
          <a class="text-link" href="/reservation/">ご予約について</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/images/golyn-logo-transparent.png" alt="" width="760" height="760" fetchpriority="high" />
      </div>
    </section>

    <section class="section" aria-labelledby="site-guide-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Explore Golyn Nail</p>
          <h2 id="site-guide-title">目的から選ぶ</h2>
          <p>各メニューは独立したページで詳しくご覧いただけます。</p>
        </div>
        <div class="page-links">
          {primaryNavigation.map((item, index) => (
            <a href={item.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.label}</strong>
              <small>詳しく見る →</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section gallery-preview" aria-labelledby="gallery-preview-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Nail Design</p>
          <h2 id="gallery-preview-title">ネイルデザイン</h2>
          <p>繊細なアートから華やかなデザインまで、実際のギャラリーデータからご紹介します。</p>
        </div>
        <div class="image-grid">
          {gallery.map((item: any, index) => (
            <figure>
              <img
                src={imageSrc(item)}
                alt={item.alt || item.title || item.label || 'Golyn Nailのネイルデザイン'}
                width="720"
                height="900"
                loading={index < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>{item.title || item.label || 'Nail Design'}</figcaption>
            </figure>
          ))}
        </div>
        <p class="center"><a class="button-link" href="/gallery/">ギャラリーをすべて見る</a></p>
      </div>
    </section>

    <section class="section services-preview" aria-labelledby="services-preview-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Services</p>
          <h2 id="services-preview-title">Golyn Nailのサービス</h2>
        </div>
        <div class="card-grid">
          <article class="content-card"><h3>ジェルネイル・ネイルアート</h3><p>ワンカラーからアートコースまで、爪の状態やご希望の雰囲気に合わせてご提案します。</p></article>
          <article class="content-card"><h3>韓国ネイル・ワンホンネイル</h3><p>トレンドを取り入れたデザインや、パーツを使った華やかなスタイルに対応します。</p></article>
          <article class="content-card"><h3>長さ出し・持ち込みデザイン</h3><p>長さ出しや参考画像をもとにしたデザインについて、施術前に内容をご相談いただけます。</p></article>
        </div>
        <p class="center"><a class="text-link" href="/services/">サービスの詳細を見る →</a></p>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .home-hero { min-height: calc(100svh - var(--header-height)); display: grid; grid-template-columns: 1.08fr .92fr; align-items: center; overflow: hidden; background: linear-gradient(120deg, var(--white) 0 58%, var(--cream-mid) 58%); }
  .hero-copy { max-width: 760px; padding: clamp(64px, 10vw, 126px) clamp(24px, 7vw, 96px); }
  h1 { margin: 0; color: var(--brown-deep); font-family: var(--serif); font-size: clamp(46px, 7vw, 82px); font-weight: 400; line-height: 1.03; letter-spacing: .01em; }
  h1 span { color: var(--gold); font-size: .64em; font-style: italic; }
  .hero-lead { max-width: 700px; margin: 28px 0 0; color: var(--text-mid); font-size: 16px; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 34px; }
  .hero-art { display: grid; place-items: center; min-height: 100%; padding: 50px; }
  .hero-art img { width: min(78%, 520px); filter: drop-shadow(0 26px 45px rgba(46,26,8,.16)); }
  .page-links { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--cream-deep); border: 1px solid var(--cream-deep); }
  .page-links a { min-height: 175px; display: flex; flex-direction: column; justify-content: space-between; padding: 24px; background: var(--white); color: var(--brown-deep); text-decoration: none; transition: background .2s, color .2s; }
  .page-links a:hover { background: var(--brown-deep); color: var(--cream); }
  .page-links span { color: var(--gold); font-size: 12px; }
  .page-links strong { font-family: var(--serif); font-size: 24px; font-weight: 500; }
  .page-links small { color: currentColor; opacity: .68; }
  .gallery-preview { background: var(--white); }
  .image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  figure { margin: 0; position: relative; overflow: hidden; background: var(--cream-mid); }
  figure img { width: 100%; aspect-ratio: 4/5; object-fit: cover; transition: transform .5s; }
  figure:hover img { transform: scale(1.03); }
  figcaption { position: absolute; inset: auto 0 0; padding: 32px 18px 14px; background: linear-gradient(transparent, rgba(46,26,8,.76)); color: white; font-size: 13px; }
  .center { margin: 36px 0 0; text-align: center; }
  @media (max-width: 900px) { .home-hero { grid-template-columns: 1fr; background: var(--white); } .hero-art { min-height: 320px; background: var(--cream-mid); } .page-links { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .image-grid { grid-template-columns: repeat(2, 1fr); } .page-links { grid-template-columns: 1fr; } .page-links a { min-height: 140px; } }
</style>
