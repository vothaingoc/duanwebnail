---
import StaffDetail from '../../components/StaffDetail.astro';
import SiteLayout from '../../components/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getStaffMembers } from '../../lib/sanity';

export async function getStaticPaths() {
  const staffMembers = await getStaffMembers();
  return staffMembers.map((staff) => ({ params: { slug: staff.slug }, props: { staff } }));
}

const { staff } = Astro.props;
const title = `${staff.name}｜スタッフ紹介｜Golyn Nail`;
const description = `${staff.name}（${staff.position}）の公開済みプロフィール、得意分野、資格、担当デザインをご紹介します。`;
---

<SiteLayout title={title} description={description} path={`/staff/${staff.slug}/`} image={staff.photo}>
  <main>
    <Breadcrumbs items={[{ label: 'スタッフ紹介', href: '/staff/' }, { label: staff.name }]} />
    <section class="detail-section">
      <StaffDetail staff={staff} />
      <p class="back"><a class="button-link" href="/staff/">スタッフ一覧へ戻る</a></p>
    </section>
  </main>
</SiteLayout>

<style>
  .detail-section { max-width: 1100px; margin: 0 auto; padding: clamp(54px, 8vw, 94px) 24px; }
  .profile { display: grid; grid-template-columns: minmax(0, 420px) 1fr; gap: 52px; align-items: center; }
  .profile-image img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .profile-position { color: var(--gold); letter-spacing: .15em; }
  .profile h1 { margin: 0; color: var(--brown-deep); font-family: var(--serif); font-size: clamp(46px, 7vw, 72px); font-weight: 500; }
  .profile-facts { margin-top: 24px; border-top: 1px solid var(--cream-deep); }
  .profile-facts > div { display: grid; grid-template-columns: 120px 1fr; padding: 14px 0; border-bottom: 1px solid var(--cream-deep); }
  dt { color: var(--text-light); } dd { margin: 0; color: var(--text-mid); }
  .profile-text { color: var(--text-mid); }
  .staff-gallery { margin-top: 70px; }
  .staff-gallery .section-heading { text-align: center; }
  .staff-gallery .section-heading > p { color: var(--gold); }
  .staff-gallery h2 { color: var(--brown-deep); font-family: var(--serif); font-size: 40px; font-weight: 500; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .gallery-grid img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .back { margin-top: 48px; text-align: center; }
  @media (max-width: 760px) { .profile { grid-template-columns: 1fr; } .gallery-grid { grid-template-columns: 1fr 1fr; } }
</style>
