---
import StaffCard from '../../components/StaffCard.astro';
import SiteLayout from '../../components/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getStaffMembers } from '../../lib/sanity';
import { pageSeo } from '../../data/site';

const staffMembers = await getStaffMembers();
---

<SiteLayout title={pageSeo.staff.title} description={pageSeo.staff.description} path="/staff/">
  <main>
    <Breadcrumbs items={[{ label: 'スタッフ紹介' }]} />
    <section class="page-hero"><p class="eyebrow">Staff</p><h1>スタッフ紹介</h1><p class="lead">確認済みのプロフィールが公開されたスタッフをご紹介します。</p><div class="gold-line"></div></section>
    <section class="section" aria-labelledby="staff-list-title">
      <div class="section-inner">
        <div class="section-heading"><p class="eyebrow">Members</p><h2 id="staff-list-title">ネイリスト一覧</h2></div>
        {staffMembers.length ? <div class="staff-grid">{staffMembers.map((staff) => <StaffCard staff={staff} />)}</div> : <p class="notice">スタッフ情報はただいま準備中です。確認済みのスタッフ情報が公開されると、こちらに表示されます。</p>}
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .staff-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .staff-card { display: flex; flex-direction: column; overflow: hidden; background: var(--white); border: 1px solid var(--cream-deep); }
  .staff-card-image img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .staff-card-body { display: flex; flex: 1; flex-direction: column; padding: 24px; }
  .staff-position { margin: 0; color: var(--gold); font-size: 12px; letter-spacing: .16em; }
  .staff-card h2 { margin: 6px 0; color: var(--brown-deep); font-family: var(--serif); font-size: 32px; font-weight: 500; }
  .staff-intro { flex: 1; color: var(--text-mid); }
  .staff-button { color: var(--brown); font-weight: 500; text-underline-offset: 3px; }
  @media (max-width: 800px) { .staff-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .staff-grid { grid-template-columns: 1fr; } }
</style>
