---
import { business, officialSocialUrls } from '../config/business';
import { primaryNavigation, supportedLanguages } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  image = business.socialImage,
  type = 'website',
  noindex = false,
  lang = 'ja',
  jsonLd,
} = Astro.props;
const canonical = new URL(path, business.siteUrl).toString();
const socialImage = new URL(image, business.siteUrl).toString();
const currentPath = Astro.url.pathname;
const schema = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const organizationSchema = currentPath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${business.siteUrl}/#organization`,
  name: business.name,
  alternateName: business.japaneseName,
  url: `${business.siteUrl}/`,
  logo: new URL(business.logo, business.siteUrl).toString(),
  sameAs: officialSocialUrls,
  areaServed: { '@type': 'AdministrativeArea', name: business.serviceArea },
} : null;
const websiteSchema = currentPath === '/' ? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${business.siteUrl}/#website`,
  url: `${business.siteUrl}/`,
  name: business.name,
  alternateName: business.japaneseName,
  inLanguage: 'ja',
  publisher: { '@id': `${business.siteUrl}/#organization` },
} : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && lang === 'ja' && <link rel="alternate" hreflang="ja" href={canonical} />}
    {!noindex && lang === 'ja' && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : lang} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Jost:wght@300;400;500&family=Noto+Sans+JP:wght@300;400;500&display=swap"
    />
    {organizationSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
    {websiteSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {schema.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Golyn Nail ホーム">
        <img src={business.logo} alt="Golyn Nail（ゴーリンネイル）" width="240" height="96" />
      </a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">
        <ul>
          {primaryNavigation.map((item) => (
            <li><a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <details class="language-menu">
        <summary aria-label="言語を選択">{supportedLanguages.find((item) => item.code === lang)?.label || 'Language'}</summary>
        <ul>
          {supportedLanguages.map((item) => (
            <li><a href={item.href} lang={item.code} aria-current={item.code === lang ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </details>
      <details class="mobile-menu">
        <summary aria-label="メニューを開く"><span></span><span></span><span></span></summary>
        <nav aria-label="モバイルナビゲーション">
          <ul>
            {primaryNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
      </details>
    </header>
    <div id="main-content"><slot /></div>
    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/"><img src={business.logo} alt="Golyn Nail" width="200" height="80" loading="lazy" /></a>
          <p>大阪でオープン準備中のネイルサロン<br />Golyn Nail（ゴーリンネイル）</p>
        </div>
        <nav aria-label="フッターナビゲーション">
          <p class="footer-heading">Site Links</p>
          <ul>{primaryNavigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </nav>
        <div>
          <p class="footer-heading">Official Social</p>
          <ul>
            <li><a href={business.socials.instagram} rel="noopener noreferrer" target="_blank">Instagram</a></li>
            <li><a href={business.socials.facebook} rel="noopener noreferrer" target="_blank">Facebook</a></li>
            <li><a href={business.socials.tiktok} rel="noopener noreferrer" target="_blank">TikTok</a></li>
          </ul>
        </div>
      </div>
      <p class="copyright">© 2026 Golyn Nail. All rights reserved.</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  :root {
    --cream: #f5efe6;
    --cream-mid: #ebdeca;
    --cream-deep: #d4bd99;
    --white: #fffaf3;
    --brown: #5c3d1e;
    --brown-deep: #2e1a08;
    --gold: #b98734;
    --gold-light: #e8c97a;
    --text: #1c1008;
    --text-mid: #563a20;
    --text-light: #8a673c;
    --serif: 'Cormorant Garamond', 'Noto Serif JP', serif;
    --sans: 'Jost', 'Noto Sans JP', sans-serif;
    --header-height: 76px;
  }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--cream); color: var(--text); font-family: var(--sans); font-weight: 300; line-height: 1.8; }
  body::before { content: ''; position: fixed; inset: 0; pointer-events: none; opacity: .18; background-image: radial-gradient(rgba(92,61,30,.22) .5px, transparent .5px); background-size: 8px 8px; z-index: -1; }
  img { display: block; max-width: 100%; height: auto; }
  a { color: inherit; }
  button, summary { font: inherit; }
  .skip-link { position: fixed; left: 12px; top: -60px; z-index: 1000; background: var(--brown-deep); color: white; padding: 10px 16px; }
  .skip-link:focus { top: 12px; }
  .site-header { position: sticky; top: 0; z-index: 100; min-height: var(--header-height); display: flex; align-items: center; gap: 22px; padding: 8px clamp(18px, 4vw, 56px); background: rgba(245,239,230,.96); border-bottom: 1px solid rgba(185,135,52,.32); backdrop-filter: blur(14px); }
  .brand { flex: 0 0 auto; }
  .brand img { width: 128px; height: 52px; object-fit: contain; mix-blend-mode: multiply; }
  .desktop-nav { flex: 1; }
  .desktop-nav ul { display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.6vw, 26px); margin: 0; padding: 0; list-style: none; }
  .desktop-nav a { display: block; color: var(--text-mid); text-decoration: none; font-size: 13px; font-weight: 400; letter-spacing: .06em; white-space: nowrap; }
  .desktop-nav a:hover, .desktop-nav a[aria-current='page'] { color: var(--gold); }
  details summary { cursor: pointer; }
  .language-menu { position: relative; flex: 0 0 auto; }
  .language-menu summary { min-width: 100px; padding: 7px 12px; border: 1px solid var(--cream-deep); border-radius: 999px; color: var(--text-mid); font-size: 12px; list-style: none; text-align: center; }
  .language-menu summary::-webkit-details-marker, .mobile-menu summary::-webkit-details-marker { display: none; }
  .language-menu ul { position: absolute; right: 0; top: calc(100% + 9px); min-width: 168px; margin: 0; padding: 8px; list-style: none; background: var(--white); border: 1px solid var(--cream-deep); border-radius: 10px; box-shadow: 0 18px 50px rgba(46,26,8,.18); }
  .language-menu a { display: block; padding: 7px 9px; border-radius: 6px; text-decoration: none; font-size: 13px; }
  .language-menu a:hover, .language-menu a[aria-current='page'] { background: var(--cream); color: var(--gold); }
  .mobile-menu { display: none; margin-left: auto; }
  .mobile-menu > summary { display: grid; gap: 5px; padding: 8px; list-style: none; }
  .mobile-menu > summary span { display: block; width: 24px; height: 1.5px; background: var(--brown-deep); }
  .mobile-menu nav { position: fixed; top: var(--header-height); left: 0; right: 0; padding: 22px; background: var(--white); border-bottom: 1px solid var(--cream-deep); box-shadow: 0 20px 35px rgba(46,26,8,.14); }
  .mobile-menu ul { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; margin: 0; padding: 0; list-style: none; }
  .mobile-menu a { display: block; padding: 8px 0; text-decoration: none; color: var(--text-mid); }
  .page-hero { padding: clamp(64px, 10vw, 118px) 24px clamp(46px, 7vw, 78px); background: linear-gradient(135deg, var(--white), var(--cream)); text-align: center; border-bottom: 1px solid rgba(185,135,52,.22); }
  .eyebrow { margin: 0 0 10px; color: var(--gold); font-size: 12px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
  .page-hero h1 { max-width: 920px; margin: 0 auto; color: var(--brown-deep); font-family: var(--serif); font-size: clamp(38px, 7vw, 68px); font-weight: 400; line-height: 1.12; letter-spacing: .02em; }
  .page-hero .lead { max-width: 760px; margin: 22px auto 0; color: var(--text-mid); font-size: clamp(15px, 2vw, 17px); }
  .gold-line { width: 62px; height: 1px; margin: 24px auto 0; background: var(--gold); }
  .section { padding: clamp(64px, 9vw, 104px) 24px; }
  .section-inner { max-width: 1180px; margin: 0 auto; }
  .section-heading { max-width: 760px; margin: 0 auto 42px; text-align: center; }
  .section-heading h2 { margin: 0; color: var(--brown-deep); font-family: var(--serif); font-size: clamp(32px, 5vw, 50px); font-weight: 400; line-height: 1.18; }
  .section-heading p:last-child { color: var(--text-mid); }
  .card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .content-card { padding: 30px; background: rgba(255,250,243,.86); border: 1px solid rgba(212,189,153,.72); border-radius: 4px; box-shadow: 0 12px 34px rgba(46,26,8,.055); }
  .content-card h2, .content-card h3 { margin-top: 0; color: var(--brown-deep); font-family: var(--serif); font-weight: 500; line-height: 1.25; }
  .content-card h2 { font-size: 29px; }
  .content-card h3 { font-size: 25px; }
  .text-link, .button-link { display: inline-flex; align-items: center; gap: 8px; color: var(--brown); font-weight: 500; text-underline-offset: 4px; }
  .button-link { padding: 12px 24px; background: var(--brown-deep); color: var(--white); text-decoration: none; border-radius: 2px; }
  .button-link:hover { background: var(--brown); }
  .notice { max-width: 820px; margin: 0 auto; padding: 30px; background: var(--white); border: 1px solid var(--cream-deep); border-left: 4px solid var(--gold); }
  .site-footer { padding: 58px clamp(24px, 6vw, 80px) 24px; background: var(--brown-deep); color: var(--cream); }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 44px; max-width: 1180px; margin: 0 auto 44px; }
  .footer-brand img { width: 148px; height: 58px; object-fit: contain; background: var(--cream); mix-blend-mode: normal; }
  .footer-brand p { color: rgba(245,239,230,.68); font-size: 14px; }
  .footer-heading { margin: 0 0 12px; color: var(--gold-light); font-size: 14px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .site-footer ul { margin: 0; padding: 0; list-style: none; }
  .site-footer li + li { margin-top: 6px; }
  .site-footer a { color: rgba(245,239,230,.78); text-decoration: none; font-size: 14px; }
  .site-footer a:hover { color: var(--gold-light); }
  .copyright { max-width: 1180px; margin: 0 auto; padding-top: 20px; border-top: 1px solid rgba(232,201,122,.2); color: rgba(245,239,230,.45); font-size: 12px; }
  @media (max-width: 1100px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
    .language-menu { margin-left: auto; }
  }
  @media (max-width: 760px) {
    .site-header { gap: 10px; }
    .brand img { width: 108px; }
    .language-menu summary { min-width: 86px; padding: 6px 9px; }
    .card-grid, .footer-grid { grid-template-columns: 1fr; }
    .footer-grid { gap: 30px; }
    .content-card { padding: 24px; }
  }
  @media (max-width: 420px) {
    .mobile-menu ul { grid-template-columns: 1fr; }
  }
</style>
