---
import { business } from '../config/business';

type Crumb = { label: string; href?: string };
interface Props { items: Crumb[] }
const { items } = Astro.props;
const allItems: Crumb[] = [{ label: 'ホーム', href: '/' }, ...items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: allItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href || Astro.url.pathname, business.siteUrl).toString(),
  })),
};
---

<nav class="breadcrumbs" aria-label="パンくずリスト">
  <ol>
    {allItems.map((item, index) => (
      <li>
        {item.href && index < allItems.length - 1 ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs { max-width: 1180px; margin: 0 auto; padding: 18px 24px; }
  ol { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; color: var(--text-light); font-size: 13px; }
  li + li::before { content: '/'; margin-right: 8px; color: var(--cream-deep); }
  a { color: var(--text-mid); text-underline-offset: 3px; }
</style>
