---
const translations = {
  "ja": "当サロンが掲載するネイル写真は、すべて当サロンで実際に施術したデザインを撮影したものです。AI生成画像は使用しておりません。",
  "en": "All nail photos we publish show designs actually created at our salon. We do not use AI-generated images.",
  "vi": "Tất cả ảnh nail chúng tôi đăng tải đều là ảnh chụp những mẫu do chính tiệm thực hiện. Chúng tôi không sử dụng ảnh do AI tạo ra.",
  "zh": "本店发布的所有美甲照片均为本店实际完成的作品实拍，不使用AI生成图片。",
  "ko": "저희가 게시하는 모든 네일 사진은 저희 살롱에서 실제로 시술한 디자인을 촬영한 것입니다. AI 생성 이미지는 사용하지 않습니다.",
  "my": "ကျွန်ုပ်တို့ တင်ထားသော လက်သည်းဓာတ်ပုံအားလုံးသည် ကျွန်ုပ်တို့ဆိုင်တွင် အမှန်တကယ် ပြုလုပ်ထားသော ဒီဇိုင်းများကို ရိုက်ကူးထားခြင်းဖြစ်ပါသည်။ AI ဖြင့် ဖန်တီးထားသော ပုံများကို အသုံးမပြုပါ။",
  "id": "Semua foto kuku yang kami publikasikan adalah foto desain yang benar-benar dikerjakan di salon kami. Kami tidak menggunakan gambar buatan AI."
};
---
<p class="photo-disclaimer" data-i18n="photo_disclaimer">{translations.ja}</p>
<script is:inline define:vars={{ translations }}>
  window.golynPhotoDisclaimer = translations;
</script>
<style>
  .photo-disclaimer {
    max-width: 760px;
    margin: 20px auto 0;
    padding: 0 12px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.9;
    color: var(--text-light);
    text-align: center;
    letter-spacing: .03em;
  }
</style>

